import '../tailwind.css';
import { Card, CardHeader } from '@app/common/ui';
import { Route, Routes } from 'react-router-dom';

// Example MFE — thay nội dung domain thật của bạn vào đây (Tailwind utility-first).
// Component này expose qua MF (./{{pascalCase name}}App); shell render dưới
// route /{{kebabCase name}}/*. Dùng <Routes> con cho sub-route (vd /{{kebabCase name}}/:id).
function {{pascalCase name}}Home() {
  return (
    <div className="mx-auto max-w-[680px]">
      <Card>
        <CardHeader title="{{label}}" subtitle="mfe-{{kebabCase name}}" />
        <p className="text-sm text-text-muted">
          MFE <strong>{{kebabCase name}}</strong> đang chạy. Thay nội dung này bằng tính năng thật.
        </p>
      </Card>
    </div>
  );
}

export default function {{pascalCase name}}App() {
  return (
    <Routes>
      <Route index element={<{{pascalCase name}}Home />} />
    </Routes>
  );
}
