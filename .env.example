# Env matrix của base Modern.js Federated SSR
# (xem README mục 10-11 — các giá trị dưới là ví dụ, không bắt buộc file .env)

# --- Lúc BUILD ---
# URL browser-facing cho static assets của từng app (bake vào publicPath + ssrPublicPath)
# PUBLIC_URL=https://cdn.company.com/mfe-accounts/

# (chỉ shell) base URL mf-manifest.json của các remote khi deploy CDN/S3
# REMOTE_BASE=https://cdn.company.com

# --- Lúc RUNTIME (prod server: pnpm serve) ---
# Port server SSR (modern serve đọc qua modern.config.ts)
# PORT=3000

# (chỉ shell, trong Docker/ECS) rewrite host server-side: public URL → hostname nội bộ
# MF_INTERNAL_HOST_MAP={"http://localhost:3002":"http://mfe-accounts:3002"}

# (remote containers) bật CORS middleware cho manifest/chunks cross-origin
# MODERN_MF_AUTO_CORS=true

# --- Observability & mock (browser — phải prefix MODERN_ để Modern.js inline) ---
# Sentry DSN — không set thì initSentry() no-op
# MODERN_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# MODERN_PUBLIC_SENTRY_ENV=production
# Bật MSW worker ở dev (mặc định tắt để không phá SSR/build)
# MODERN_MSW=true
