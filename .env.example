# ============================================================================
# Env matrix — chia SECTION theo module (bank pattern).
# Cách dùng: cp .env.example .env.local → sửa giá trị →
#   node scripts/sync-env.mjs   (đẩy từng section xuống <module>/.env.local,
#   chỉ THÊM key thiếu; muốn ghi đè: --force)
# KHÔNG xóa các dòng marker `# <module>` / `# end <module>`.
# Mọi biến là BUILD-TIME (Modern.js inline) → đổi env phải restart dev/rebuild.
# ============================================================================

# global
# Base URL API gateway. Để TRỐNG = same-origin → MSW làm mock backend (dev).
# Dự án thật: trỏ gateway, vd https://api.company.com/gateway
MODERN_API_BASE_URL=
# Bật MSW ở bản build production (demo/e2e). Dev luôn bật sẵn.
# MODERN_MSW=true
# Sentry (không set → initSentry no-op)
# MODERN_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# MODERN_PUBLIC_SENTRY_ENV=production
# end global

# shell
# PORT=3000
# Base URL manifest các remote khi deploy CDN/S3 (không set = per-remote bên dưới)
# REMOTE_BASE=https://cdn.company.com
# end shell

# mfe-auth
# REMOTE_HOST_MFE_AUTH=https://auth.company.com
# REMOTE_PORT_MFE_AUTH=443
# REMOTE_BASE_PATH_MFE_AUTH=mfe-auth
# PUBLIC_URL=https://auth.company.com/mfe-auth/
# end mfe-auth

# mfe-accounts
# REMOTE_HOST_MFE_ACCOUNTS=https://accounts.company.com
# REMOTE_PORT_MFE_ACCOUNTS=443
# REMOTE_BASE_PATH_MFE_ACCOUNTS=mfe-accounts
# PUBLIC_URL=https://accounts.company.com/mfe-accounts/
# end mfe-accounts

# mfe-transfer
# REMOTE_HOST_MFE_TRANSFER=https://transfer.company.com
# end mfe-transfer

# mfe-cards
# REMOTE_HOST_MFE_CARDS=https://cards.company.com
# end mfe-cards

# mfe-loans
# REMOTE_HOST_MFE_LOANS=https://loans.company.com
# end mfe-loans

# mfe-profile
# REMOTE_HOST_MFE_PROFILE=https://profile.company.com
# end mfe-profile
