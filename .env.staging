# ============================================================================
# Môi trường STAGING — file này COMMIT vào git (như bank), domain là placeholder:
# thay bằng domain thật của công ty khi dùng.
# QUAN TRỌNG: không xóa các dòng marker `# <module>` / `# end <module>` —
# scripts (sync-env/dev-select/with-env) định vị section theo chúng.
# Mọi biến là BUILD-TIME (Modern.js inline) → đổi env phải restart/rebuild.
# ============================================================================

# global
MODERN_ENV=staging
MODERN_API_BASE_URL=https://api.staging.company.com/gateway
# Môi trường thật không dùng mock backend
MODERN_MSW=false
# MODERN_PUBLIC_SENTRY_DSN=
# MODERN_PUBLIC_SENTRY_ENV=staging
# end global

# shell
# REMOTE_BASE: nếu deploy chung 1 CDN thì set cái này thay cho từng REMOTE_HOST bên dưới
# REMOTE_BASE=https://cdn.staging.company.com
# end shell

# mfe-auth
REMOTE_HOST_MFE_AUTH=https://mfe-auth.staging.company.com
REMOTE_PORT_MFE_AUTH=
REMOTE_BASE_PATH_MFE_AUTH=
# end mfe-auth

